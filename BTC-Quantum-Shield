 Quick Start
1. Install
git clone https://github.com/your-org/btc-quantum-shield.git
cd btc-quantum-shield
pip install -e ".[dev]"
2. Generate a Post-Quantum Wallet
from quantum_shield import QuantumWallet

# Create a new PQ wallet (Dilithium3 + secp256k1 hybrid)
wallet = QuantumWallet.generate(algorithm="dilithium3")

print(wallet.pq_public_key.hex())   # CRYSTALS-Dilithium public key
print(wallet.btc_address)           # Taproot P2TR address
print(wallet.hns_identity)          # HNS Protocol identity hash
3. Anchor an Existing Address
from quantum_shield import HNSProtocol

hns = HNSProtocol(network="mainnet")

# Bind your existing BTC address to a PQ key
tx = hns.anchor(
    btc_address="bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh",
    pq_pubkey=wallet.pq_public_key,
)
print(f"Anchor TX: {tx.txid}") 
4. Migrate to Quantum-Safe Output
from quantum_shield import MigrationEngine

engine = MigrationEngine(wallet)
sweep_tx = engine.migrate(
    from_address="bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh",
    private_key_wif="your_wif_here",         # kept offline
    destination=wallet.btc_address,           # new P2TR PQ-secured address
)
engine.broadcast(sweep_tx) 
